<script>
  let currentMarkFilter = 'all';

  function filterMarks(mark, btn) {
    currentMarkFilter = mark;
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
  }

  function applyFilters() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    const repeatOnly = document.getElementById('repeatOnly').checked;

    document.querySelectorAll('.mark-section').forEach(section => {
      const sectionMark = section.getAttribute('data-section');
      const matchesMark = (currentMarkFilter === 'all' || currentMarkFilter === sectionMark);

      if (!matchesMark) {
        section.style.display = 'none';
        return;
      }

      let visibleRows = 0;
      section.querySelectorAll('tbody tr').forEach(row => {
        const text = row.innerText.toLowerCase();
        const isRepeated = row.getAttribute('data-repeated') === 'true';
        const matchesSearch = text.includes(query);
        const matchesRepeat = !repeatOnly || isRepeated;

        if (matchesSearch && matchesRepeat) {
          row.style.display = '';
          visibleRows++;
        } else {
          row.style.display = 'none';
        }
      });

      section.style.display = visibleRows > 0 ? '' : 'none';
    });
  }
</script>

